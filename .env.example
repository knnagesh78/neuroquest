# The supplied public Firebase web config is already the default in src/lib/firebase.ts.
# Optional overrides for a separate project. Do not put service-account keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local emulators only. Never enable this for deployment.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
