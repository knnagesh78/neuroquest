# Copy .env.example to .env.local for browser Firebase configuration, then add these.
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ or commit real values.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
TRIPO_API_KEY=replace-with-your-tripo-api-key
TRIPO_MODEL_VERSION=v2.5-20250123

# Dedicated Firebase service account with Firestore and Storage access.
# Use the SAME project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_ADMIN_CLIENT_EMAIL=your-server-account@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Alternative on Google infrastructure: GOOGLE_APPLICATION_CREDENTIALS + ADC.
# Require App Check only after registering/enabling it for the browser app.
FIREBASE_REQUIRE_APP_CHECK=false

# Durable daily limits across all server instances. 0 disables generation.
AI_DAILY_USER_LIMIT=3
AI_DAILY_GLOBAL_LIMIT=50

# Optional additional Tripo asset host suffixes, separated by commas.
TRIPO_ASSET_HOSTS=
