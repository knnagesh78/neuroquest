# Public Firebase browser configuration. These values identify the Firebase app;
# they are not server credentials. Never put service-account keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Optional public reCAPTCHA v3 site key, after registering the app in Firebase App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Local emulators only. Never enable this for deployment.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
